{
  "name": "dashboard-ui",
  "version": "0.2.3",
  "type": "module",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/plots": "^2.6.8",
    "@dicebear/adventurer": "^9.2.4",
    "@dicebear/avataaars": "^9.2.4",
    "@dicebear/big-smile": "^9.2.4",
    "@dicebear/bottts": "^9.2.4",
    "@dicebear/core": "^9.4.3",
    "@dicebear/fun-emoji": "^9.2.4",
    "@dicebear/identicon": "^9.2.4",
    "@dicebear/lorelei": "^9.2.4",
    "@dicebear/micah": "^9.2.4",
    "@dicebear/miniavs": "^9.2.4",
    "@dicebear/open-peeps": "^9.2.4",
    "@dicebear/personas": "^9.2.4",
    "@dicebear/pixel-art": "^9.2.4",
    "@reduxjs/toolkit": "^2.13.0",
    "antd": "^6.7.0",
    "axios": "^1.21.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.9.1",
    "js-yaml": "^5.5.0",
    "loglevel": "^1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.4",
    "react-timeago": "^8.3.0",
    "redux-persist": "^6.0.0"
  },
  "scripts": {
    "dev": "vite --port 3000 --open",
    "generate:licenses": "node scripts/generate-licenses.mjs",
    "build": "npm run generate:licenses && vite build",
    "build:analyze": "npm run generate:licenses && vite build --mode analyze",
    "build:cluster": "npm run generate:licenses && vite build --mode cluster",
    "serve": "vite preview",
    "lint": "eslint .",
    "lint:f": "eslint . --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "check-all": "npm run type-check && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:duplication": "jscpd src && jscpd src --pattern \"{**/*.test.{ts,tsx},src/test/**/*.{ts,tsx}}\"",
    "check-all-and-build": "npm run type-check && npm run lint && npm run test:coverage && npm run check:duplication && npm run build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.3",
    "terser": "^5.51.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "minimatch@^10": "^11.0.5"
  }
}
